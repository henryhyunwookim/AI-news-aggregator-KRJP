# ===========================================================================
# AIFOD Daily AI News Aggregator - Environment Configuration Template
# ===========================================================================
# NOTE: In this Cloud-Native Multi-PC architecture, local .env files are OPTIONAL!
# All sensitive secrets, OAuth tokens, and state are automatically resolved from
# Google Cloud Secret Manager and Google Cloud Storage (GCS) on any workstation
# authenticated via 'gcloud auth login'.
#
# To push local credentials to Secret Manager in one shot:
#   python deployment/sync_secrets.py
# ===========================================================================

# Google Cloud Platform Infrastructure
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=ai-news-aggregator-krjp
JOB_NAME=ai-news-aggregator-daily-trigger
SCHEDULE=0 0 * * *
TIMEZONE=Asia/Tokyo

# Large Language Model (Gemini) Settings
GEMINI_MODEL=gemini-3.8-flash
STAGE1_CANDIDATES_PER_COUNTRY=10

# Google Cloud Secret Manager Resource IDs (Defaults)
SECRET_GEMINI_API_KEY=gemini-api-key
SECRET_GMAIL_TOKEN=gmail-agent-token
SECRET_GMAIL_CREDENTIALS=gmail-oauth-credentials
SECRET_RECIPIENT_EMAIL=ai-news-recipient-email

# Google Cloud Storage (GCS) State & Audit Logs
# Bucket defaults to: gs://${GCP_PROJECT_ID}-ai-news-data
GCS_BUCKET_NAME=your-gcp-project-id-ai-news-data
GCS_STATE_BLOB=ai-news-aggregator-krjp/state.json
GCS_LOG_BLOB=ai-news-aggregator-krjp/run_log.json

# Optional Local Overrides (Fallback only - Leave blank to pull from Secret Manager)
GEMINI_API_KEY=
RECIPIENT_EMAIL=your_email@example.com
RECIPIENT_NAME=AIFOD Practitioner
